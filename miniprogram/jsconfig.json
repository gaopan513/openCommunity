{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["@dcloudio/types"]
  },
  "include": ["src/**/*.js", "src/**/*.vue", "src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}