# openCommunity 后端环境变量示例
# 复制为 .env 并按需修改；生产环境必须显式设置以下安全项。
# 注意：项目当前不会自动加载 .env 文件，可用 python-dotenv 或由部署脚本 source 注入。

# ===== 基础安全（生产必填）=====
# 生产必须设置长随机密钥，否则拒绝启动；可用 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 生产必须为 False
DJANGO_DEBUG=False
# 逗号分隔的域名白名单，生产不允许 *
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# ===== CORS =====
# 生产禁止全放行，改用白名单
DJANGO_CORS_ALLOW_ALL=False
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com

# ===== 数据库（全部不设时使用本地 SQLite）=====
# 切换 PostgreSQL 示例：
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=opencommunity
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# ===== 微信小程序（小程序端登录必填；为空表示未启用 /auth/wechat-login/）=====
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
